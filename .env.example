# Copy to .env for local development:  cp .env.example .env
# Values below are DEV-ONLY placeholders. Production secrets come from a secrets
# manager and are injected at runtime; docker-compose.prod.yml fails fast if any
# required variable is missing. Never commit a real .env.

# ---- application -------------------------------------------------------------
NODE_ENV=development
SERVICE_NAME=logistics-platform
PORT=3000
OPS_PORT=9100
LOG_LEVEL=info
LOG_PRETTY=false
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=1
BODY_LIMIT=1mb
SHUTDOWN_GRACE_MS=10000

# ---- image tags (override to pin exact versions) ------------------------------
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7-alpine
KAFKA_IMAGE=apache/kafka:3.9.0
KAFKA_UI_IMAGE=kafbat/kafka-ui:latest
RABBITMQ_IMAGE=rabbitmq:4-management
MINIO_IMAGE=minio/minio:latest
MAILPIT_IMAGE=axllent/mailpit:latest
NGINX_IMAGE=nginx:1.27-alpine
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
JAEGER_IMAGE=jaegertracing/all-in-one:latest
POSTGRES_EXPORTER_IMAGE=quay.io/prometheuscommunity/postgres-exporter:latest
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:latest
KAFKA_EXPORTER_IMAGE=danielqsj/kafka-exporter:latest

# ---- PostgreSQL ----------------------------------------------------------------
POSTGRES_DB=logistics
POSTGRES_USER=postgres_admin
POSTGRES_PASSWORD=dev_only_admin_pw
APP_MIGRATOR_PASSWORD=dev_only_migrator_pw
APP_RUNTIME_PASSWORD=dev_only_runtime_pw
APP_READONLY_PASSWORD=dev_only_readonly_pw

# ---- Redis (two instances on purpose: cache evicts, queue must never) ----------
REDIS_CACHE_PASSWORD=dev_only_cache_pw
REDIS_QUEUE_PASSWORD=dev_only_queue_pw

# ---- RabbitMQ / MinIO / Grafana ------------------------------------------------
RABBITMQ_USER=app
RABBITMQ_PASSWORD=dev_only_rabbit_pw
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=dev_only_minio_pw
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=dev_only_grafana_pw
